@page
@model SmokViewer.Pages.ErrorModel

<!DOCTYPE html>
<html lang="pl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Błąd — Smok</title>
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>

<body>
    <main class="page">
        <h1 class="section-title">Coś poszło nie tak</h1>
        <p>Nie udało się obsłużyć żądania. <a href="~/">Wróć do pomiarów</a>.</p>
        @if (Model.ShowRequestId)
        {
            <p class="section-meta">Identyfikator żądania: <code>@Model.RequestId</code></p>
        }
    </main>
</body>

</html>
